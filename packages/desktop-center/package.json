{
  "name": "dsh-desktop-center",
  "version": "0.3.0-rc.8",
  "description": "Read-only DSH Desktop Center: desktop inventory and Skills comparison panel",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "desktop",
    "cordis",
    "skills",
    "dashboard",
    "plugins"
  ],
  "dependencies": {
    "@iarna/toml": "2.2.5"
  }
}
